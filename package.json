{
  "name": "nanocode-ts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "bench:board": "node bench/board-load.ts",
    "bench:board-do": "node bench/board-do.ts",
    "build": "node scripts/build.mjs && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json && tsc -p tsconfig.cloudflare.build.json",
    "check": "vp check --fix",
    "example:board-pool": "node examples/board-pool/index.ts",
    "example:board-agents": "node examples/board-agents/index.ts",
    "example:board-durable-object": "node examples/board-durable-object/index.ts",
    "example:board-postgres": "node examples/board-postgres/index.ts",
    "example:board-postgres:soak": "node examples/board-postgres/soak.ts",
    "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json && tsc --noEmit -p tsconfig.cloudflare.json && tsc --noEmit -p examples/board-agents && tsc --noEmit -p examples/board-durable-object && tsc --noEmit -p examples/board-durable-object/tsconfig.worker.json && tsc --noEmit -p examples/board-postgres",
    "prepare": "node scripts/prepare.mjs",
    "test": "node scripts/test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel/index.d.ts",
      "default": "./dist/vercel/index.js"
    },
    "./vercel/transport": {
      "types": "./dist/vercel/Transport.d.ts",
      "default": "./dist/vercel/Transport.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "default": "./dist/cloudflare/index.js"
    },
    "./cloudflare/transport": {
      "types": "./dist/cloudflare/Transport.d.ts",
      "default": "./dist/cloudflare/Transport.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./feedback/server": {
      "types": "./dist/feedback/server/index.d.ts",
      "default": "./dist/feedback/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./highlight": {
      "types": "./dist/Highlight.d.ts",
      "default": "./dist/Highlight.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    },
    "./bash": {
      "types": "./dist/bash/index.d.ts",
      "default": "./dist/bash/index.js"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "default": "./dist/machines/index.js"
    },
    "./machines/server": {
      "types": "./dist/machines/Account.d.ts",
      "default": "./dist/machines/Account.js"
    },
    "./machines/react": {
      "types": "./dist/react/Machines.d.ts",
      "default": "./dist/react/Machines.js"
    },
    "./machines/cloudflare": {
      "types": "./dist/machines/cloudflare/index.d.ts",
      "default": "./dist/machines/cloudflare/index.js"
    },
    "./machines/vercel": {
      "types": "./dist/machines/vercel.d.ts",
      "default": "./dist/machines/vercel.js"
    },
    "./sandbox/cloudflare": {
      "types": "./dist/sandbox/cloudflare.d.ts",
      "default": "./dist/sandbox/cloudflare.js"
    },
    "./sandbox/vercel": {
      "types": "./dist/sandbox/vercel.d.ts",
      "default": "./dist/sandbox/vercel.js"
    },
    "./nanocode_board.wasm": "./dist/nanocode_board.wasm",
    "./nanocode_wasm.wasm": "./dist/nanocode_wasm.wasm",
    "./interpreter.wasm": "./dist/interpreter.wasm",
    "./psh.wasm": "./dist/psh.wasm",
    "./python.wasm": "./dist/python.wasm",
    "./python.data": "./dist/python.data"
  },
  "bundleDependencies": [
    "@cloudflare/containers",
    "nanocode-egress",
    "undici"
  ],
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "accounts": "1.0.0-alpha.20261117214203-d38fbea",
    "hast-util-to-jsx-runtime": "2.3.6",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "mppx": "0.20.1",
    "nanocode-egress": "https://github.com/nanocodexyz/egress/releases/download/build-84d200b/nanocode-egress-84d200b.tgz",
    "ox": "0.14.65",
    "rehype-harden": "1.1.8",
    "rehype-sanitize": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "undici": "7.30.1",
    "unified": "11.0.5",
    "viem": "2.57.19"
  },
  "peerDependencies": {
    "@pierre/highlights": "^0.2.0",
    "@vercel/oidc": "^3.2.0",
    "@vercel/sandbox": "^3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "postgres": "^4.1.1",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pierre/highlights": {
      "optional": true
    },
    "@vercel/oidc": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "durable-harness": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@pierre/highlights": "0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vercel/oidc": "3.2.0",
    "@vercel/sandbox": "3.9.0",
    "durable-harness": "0.0.1-beta.6",
    "postgres": "4.1.1",
    "rolldown": "1.2.15",
    "typescript": "6.0.2",
    "vite-plus": "0.2.4",
    "workerd": "1.20261120.1"
  }
}
